---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { loadConfig, getConfiguredYears } from "../../utils/config-loader.js";

export async function getStaticPaths() {
  return getConfiguredYears().map((year) => ({ params: { year: String(year) } }));
}

const { year } = Astro.params;
const seasonYear = Number(year);
const allYears = getConfiguredYears();
const config = loadConfig(seasonYear);
const { rules } = config;

const requiredCourses = config.courses.filter((course) => course.roundsCount > 0);
const bonusEligibleCourses = config.courses.filter((course) => course.roundsCount === 0);
const requiredRoundsTotal = requiredCourses.reduce((total, course) => total + course.roundsCount, 0);
---

<Layout title={`Rules – ${config.league.name} – ${seasonYear}`} years={allYears} currentYear={seasonYear}>
  <Header years={allYears} currentYear={seasonYear} leagueName={config.league.name} />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-1">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-green-900 mb-2">League Rules &amp; Format</h1>
      <p class="text-gray-500 text-sm">West GTA Clublink Men's Invitational — {seasonYear} Season</p>
    </div>

    <section class="prose prose-green max-w-none mb-10 bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      {rules.introduction.map((paragraph, index) => (
        <p class={`text-gray-700 leading-relaxed ${index > 0 ? "mt-3" : ""}`}>
          {paragraph}
          {index === rules.introduction.length - 1 && (
            <>
              {" "}
              <strong>This is NOT a Clublink sanctioned event.</strong>
            </>
          )}
        </p>
      ))}
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="inline-block w-1 h-6 bg-yellow-500 rounded"></span>
        Season Play Rules
      </h2>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 space-y-4">
        <div>
          <h3 class="font-semibold text-gray-800 mb-2">Required Rounds ({requiredRoundsTotal} total)</h3>
          <p class="text-sm text-gray-600 mb-2">Each player must play and record a round at each of the following courses:</p>
          <ul class="space-y-1.5 text-sm text-gray-700">
            {requiredCourses.map((course) => (
              <li class="flex items-start gap-2">
                <span class="text-yellow-600 font-semibold mt-0.5">{course.roundsCount}×</span>
                <span>{course.name}</span>
              </li>
            ))}
          </ul>
        </div>

        <hr class="border-gray-100" />

        <div>
          <h3 class="font-semibold text-gray-800 mb-2">Bonus Rounds (top {config.league.bonusRoundsCount})</h3>
          <p class="text-sm text-gray-600 mb-2">
            After counting the best round from each required course, the next <strong>{config.league.bonusRoundsCount} best rounds</strong> from
            any course also count towards your total. These bonus rounds can come from any of the required courses
            above <em>or</em> from the bonus-eligible courses below:
          </p>
          <ul class="space-y-1.5 text-sm text-gray-700">
            {bonusEligibleCourses.map((course) => (
              <li class="flex items-start gap-2">
                <span class="text-green-600 font-semibold mt-0.5">+</span>
                <span>{course.name}</span>
              </li>
            ))}
          </ul>
          <p class="text-xs text-gray-500 mt-2">
            No rounds are required at the bonus-eligible courses — they only count toward bonus scoring.
          </p>
        </div>

        <hr class="border-gray-100" />

        <ul class="space-y-2 text-sm text-gray-700">
          <li class="flex items-start gap-2">
            <span class="text-green-600 mt-0.5">✓</span>
            All scores must be recorded in <strong>Golf Canada</strong> to count
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-600 mt-0.5">✓</span>
            <strong>Gross scores only</strong>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-600 mt-0.5">✓</span>
            Rounds from <strong>any tee</strong> are eligible — no tee requirement
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-600 mt-0.5">✓</span>
            Multiple scores can be submitted — only the <strong>best scores</strong> will count
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-600 mt-0.5">✓</span>
            All scores to be submitted to{" "}
            <a href={`mailto:${rules.scoreSubmissionEmail}`} class="text-green-700 hover:underline font-medium">
              {rules.scoreSubmissionEmail}
            </a>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-yellow-600 mt-0.5">⚠</span>
            All scores must be submitted <strong>before {rules.scoreSubmissionDeadline}</strong> to count towards the championship
          </li>
        </ul>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="inline-block w-1 h-6 bg-yellow-500 rounded"></span>
        Championship – {rules.championship.dateLabel}
      </h2>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 space-y-6">
        <div>
          <p class="text-sm text-gray-700"><strong>Location:</strong> {rules.championship.location}</p>
        </div>

        <div>
          <h3 class="font-semibold text-gray-800 mb-2">Team Seedings</h3>
          <p class="text-sm text-gray-600 mb-3">
            Teams of 4 golfers will be decided after season scoring is finished, based on the following seeding structure:
          </p>
          <div class="overflow-x-auto">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="bg-green-800 text-white">
                  <th class="px-4 py-2 text-left font-semibold rounded-tl-lg">Team</th>
                  <th class="px-4 py-2 text-center font-semibold">Seed 1</th>
                  <th class="px-4 py-2 text-center font-semibold">Seed 2</th>
                  <th class="px-4 py-2 text-center font-semibold">Seed 3</th>
                  <th class="px-4 py-2 text-center font-semibold rounded-tr-lg">Seed 4</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {rules.championship.teamSeedings.map((row) => (
                  <tr class="hover:bg-gray-50">
                    <td class="px-4 py-2 font-semibold text-green-800">Team {row.team}</td>
                    {row.seeds.map((seed) => (
                      <td class="px-4 py-2 text-center text-gray-700">{seed}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <h3 class="font-semibold text-gray-800 mb-2">Championship Format – 27 Holes</h3>
          <p class="text-sm text-gray-600 mb-3">
            Once teams of 4 are made, teams must decide on pairings for the championship round.
            The championship includes 3 × 9-hole rounds:
          </p>
          <div class="space-y-2">
            {rules.championship.formats.map((roundConfig) => (
              <div class="flex items-center gap-3 bg-green-50 rounded-lg px-4 py-3">
                <span class="text-xs font-semibold text-green-700 uppercase tracking-wide w-16 shrink-0">{roundConfig.round}</span>
                <span class="text-sm text-gray-800">{roundConfig.format}</span>
              </div>
            ))}
          </div>
          <p class="text-sm text-gray-600 mt-3">
            The <strong>champion team</strong> will be the lowest scoring team after all 27 holes.
          </p>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="inline-block w-1 h-6 bg-yellow-500 rounded"></span>
        Entry Fees &amp; Prizes
      </h2>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
            <p class="text-xs font-semibold text-yellow-700 uppercase tracking-wide mb-1">Entry Fee</p>
            <p class="text-2xl font-bold text-yellow-800">{rules.entry.fee} <span class="text-sm font-normal">/ player</span></p>
            <p class="text-xs text-yellow-700 mt-1">{rules.entry.feeNote}</p>
          </div>
          <div class="bg-green-50 border border-green-200 rounded-lg p-4">
            <p class="text-xs font-semibold text-green-700 uppercase tracking-wide mb-1">1st Place Prize</p>
            <p class="text-2xl font-bold text-green-800">{rules.entry.firstPrize} <span class="text-sm font-normal">{rules.entry.firstPrizeNote}</span></p>
            <p class="text-xs text-green-700 mt-1">Winning team</p>
          </div>
        </div>

        <ul class="space-y-2 text-sm text-gray-700">
          <li class="flex items-start gap-2">
            <span class="text-green-600 mt-0.5">✓</span>
            2nd place receives <strong>{rules.entry.secondPrize}</strong>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-600 mt-0.5">✓</span>
            {rules.entry.additionalPrizes}
          </li>
          <li class="flex items-start gap-2">
            <span class="text-yellow-600 mt-0.5">⚠</span>
            Entry fee must be sent via <strong>{rules.entry.paymentMethod}</strong> to{" "}
            <a href={`mailto:${rules.entry.paymentEmail}`} class="text-green-700 hover:underline font-medium">
              {rules.entry.paymentEmail}
            </a>{" "}
            before <strong>{rules.entry.paymentDeadline}</strong>
          </li>
        </ul>
      </div>
    </section>
  </main>
</Layout>
